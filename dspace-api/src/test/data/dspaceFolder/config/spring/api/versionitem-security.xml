<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"

       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
           http://www.springframework.org/schema/util
           http://www.springframework.org/schema/util/spring-util-3.0.xsd">

    <util:list id="createVersionAccessModesList">
        <bean class="org.dspace.versioning.VersioningItemMode">
            <property name="securities">
                <list>
                    <value>ADMIN</value>
                    <value>CUSTOM</value>
                    <value>GROUP</value>
                    <value>SUBMITTER</value>
                </list>
            </property>
            <property name="items" ref="itemsMetadata" />
            <property name="groups" ref="groupList" />
        </bean>
    </util:list>

    <util:list id="itemsMetadata" value-type="java.lang.String">
        <value>dc.contributor.author</value>
        <value>dc.contributor.editor</value>
        <value>dc.contributor.scientificeditor</value>
        <value>dc.contributor.advisor</value>
        <value>cris.virtual.unitManager</value>
    </util:list>

    <util:list id="groupList" value-type="java.lang.String">
        <value>Curators</value>
    </util:list>

    <util:list id="deleteVersionAccessModesList">
        <bean class="org.dspace.versioning.VersioningItemMode">
            <property name="securities">
                <list>
                    <value>ADMIN</value>
                    <value>CUSTOM</value>
                    <value>GROUP</value>
                </list>
            </property>
            <property name="groups" ref="groupList" />
        </bean>
    </util:list>

</beans>
