#!/bin/sh
#set -x
###########################################################################
# The contents of this file are subject to the license and copyright
# detailed in the LICENSE and NOTICE files at the root of the source
# tree and available online at
#
# http://www.dspace.org/license/
###########################################################################
# This is a Unix shell script that generate a temporary shell script to run
# the iiifuploader curation tasks over items that have images in the ORIGINAL
# bundle but have not yet the dspace.iiif.enabled metadata
# The sql to identify the items to process is hard limited to 500 to avoid
# excessive load.
# The temporary script is output in the console and removed from the disk once
# processed. If the temporary script exists the script cannot run to avoid
# concurrent execution

# Assume that this script is in the bin subdirectory of the DSpace installation directory.
BINDIR=`dirname $0`
DSPACEDIR=`cd "$BINDIR/.." ; pwd`
IIIF_FILE=$DSPACEDIR/resources-tobe-processed-iiif.sh

# Check if an admin email has been provided
if [ -z "$1" ]; then
    echo "You must provide the email of an administrator as argument."
    exit 1
fi
ADMIN_EMAIL=$1

# Check if the file with the iiif resources already exists
if [ -e "$IIIF_FILE" ]; then
    echo "IIIF File already exists. Check if the script is already running, kill it and remove the file to proceed."
    exit 1
fi

DB_USERNAME=`$BINDIR/dspace dsprop --property db.username`
DB_PASSWORD=`$BINDIR/dspace dsprop --property db.password`
export PGPASSWORD=$DB_PASSWORD
DB_URL=`$BINDIR/dspace dsprop --property db.url`

# Strip the prefix
url_without_prefix=$(echo "$DB_URL" | sed 's/^jdbc:postgresql:\/\///')

# Extract the host, port and name
DB_HOST=$(echo "$url_without_prefix" | cut -d':' -f1)
DB_PORT=$(echo "$url_without_prefix" | cut -d':' -f2 | cut -d'/' -f1)
DB_NAME=$(echo "$url_without_prefix" | cut -d'/' -f2 | cut -d'?' -f1)

# SQL query
SQL_QUERY="
select '$DSPACEDIR/bin/dspace curate -e $ADMIN_EMAIL -t iiifuploader -i ' || handle from item2bundle
    left join handle on item_id = resource_id and resource_type_id = 2
    where bundle_id in (
        select bnd.bundle_id from bitstream b
            right join bundle2bitstream bnd on b.uuid = bnd.bitstream_id
        where b.bitstream_format_id in (
            select bitstream_format_id from bitstreamformatregistry
                where mimetype like '%image%'
        ) AND bnd.bundle_id in (
            select dspace_object_id from metadatavalue where text_value = 'ORIGINAL'
        )
    )
    and item_id not in (
        select dspace_object_id from metadatavalue 
        where metadata_field_id in (
            select metadata_field_id from metadatafieldregistry where element = 'iiif' and qualifier = 'enabled'
        )
    ) LIMIT 500
"

# Run the query and save the result without CSV header
psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USERNAME" -d "$DB_NAME" -c "\copy ($SQL_QUERY) TO '$IIIF_FILE' WITH CSV"

sed -i '1i #set -x' $IIIF_FILE
sed -i '1i #!/bin/sh' $IIIF_FILE

echo "Items to process extracted"
chmod +x $IIIF_FILE

more $IIIF_FILE

echo "Executing the generated script"
"$IIIF_FILE"

echo "Removing the generated script"
rm $IIIF_FILE
