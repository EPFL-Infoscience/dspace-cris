{
  "Type": "@dc.type@",
	"Title": "@dc.title@",
	"Isbn": "@dc.relation.isbn@",
	"Doi": "@dc.identifier.doi@",
	"DoiType": "doi",
	"Language": "@dc.language.iso@",
	"Year": "@dc.date.issued@",
	"Notes": "@dc.description.notes@",
	"Abstract": "@dc.description.abstract@",
	"Keywords":[
	    "@dc.subject@",
	    ],
	"IsProducedAtEpfl": "@virtual.mapConverter.writtenAtEpfl.epfl-writtenAt@",
	"Reviewed": "@epfl.peerreviewed@",
	"Status": "@oaire.version@",
	"Distribution": {
	  "Place": "@dc.publisher.place@",
	  "Publisher": "@dc.publisher@",
	  "Year": "@dc.date.issued@",
	},
	"Series": {
	  "Name": "@dc.relation.ispartofseries@",
	},
	"Host": {
	@if.metadata.dc-relation-ispartof.start@
	  "Name": "@dc.relation.ispartof@",
	@if.metadata.dc-relation-ispartof.end@
	@if.metadata.dc-relation-journal.start@
      "JournalName": "@dc.relation.journal@",
      "Articlenumber": "@oaire.citation.articlenumber@",
    @if.metadata.dc-relation-journal.end@
    @if.metadata.oaire-citation-startPage.start@
	  "Pages": "@virtual.fullpage@",
    @if.metadata.oaire-citation-startPage.end@
	  "Num": "@oaire.citation.issue@",
	  "Vol": "@oaire.citation.volume@",
	  "Issn": "@dc.relation.issn@",
	  "Isbn": "@dc.relation.isbn@",
	},
	"Persons": [
	@group.dc-contributor-author.start@
    {
      "Name": "@dc.contributor.author@",
      "Orcid": "@cris.virtual.author-orcid@",
      "Sciper": "@cris.virtual.author-sciperId@",
      "Affiliation": "@oairecerif.author.affiliation@"
    },
    @group.dc-contributor-author.end@
	],
	"Editors": [
    @group.dc-contributor-scientificeditor.start@
    {
      "Name": "@dc.contributor.scientificeditor@",
      "Orcid": "@cris.virtual.scientificeditor-orcid@",
      "Sciper": "@cris.virtual.scientificeditor-sciperId@",
      "Affiliation": "@oairecerif.scientificeditor.affiliation@"
    },
    @group.dc-contributor-editor.end@
    @group.epfl-contributor-advisor.start@
    {
      "Name": "@epfl.contributor.advisor@",
      "Orcid": "@person.identifier.orcid@",
      "Sciper": "@cris.virtual.advisor-sciperId@",
      "Affiliation": "@oairecerif.advisor.affiliation@"
    },
    @group.epfl-contributor-advisor.end@
  ],
	"Meeting": {
	  "Name": "@dc.relation.conference@",
	  @relation.dc-relation-conference.start@
            "Place": "@oairecerif.event.place@",
            "Date": "@oairecerif.event.startDate@",
      @relation.dc-relation-conference.end@
	  "Place": "@oaire.citation.conferencePlace@",
	  "Date": "@oaire.citation.conferenceDate@",
	},
	"Units": [
	@relation.dc-description-sponsorship.start@
	        "uni-acronym": "@oairecerif.acronym@",
	        "unit-code": "@epfl.unit.code@",
	        "unit-authid": "@virtual.id@",
	@relation.dc-description-sponsorship.end@
	"unit": "@dc.description.sponsorship@",
	],
	"Resources": [
	  @group.bundle-original.start@
	  {
	    "Url": "@virtual.bitstreamData.original.download-path@",
	    "Description": "@virtual.bitstreamData.original.metadata.dc-file-type@",
	    "Version": "@virtual.bitstreamData.original.metadata.oaire-version@",
	    "Licence": "@virtual.bitstreamData.original.metadata.oaire-licenseCondition@",
	  },
	  @group.bundle-original.end@
	],
	"WorkType": "@epfl.thesis.degreelevel@",
	"ThesisNo": "@epfl.thesis.number@",
	"Faculty": "@epfl.thesis.faculty@",
	"Section": "@epfl.thesis.section@",
	"Institute": "@epfl.thesis.institute@",
	"DoctoralSchool": "@epfl.thesis.doctoralSchool@",
	"Unit": "@epfl.thesis.originalUnit@",
	"ThesisYear": "@dc.date.accepted@",
}