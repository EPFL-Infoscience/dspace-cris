<div class="list-group-item list-group-item-publication">
    <div class="row">
        <div class="col-md-10">
            <h4 class="h5 tex2jax_process infoscience_title">@dc.title@</h4>
            <p class="text-muted small mb-2 infoscience_authors">
            @group.dc-contributor-author.start@
                <span class="text-muted infoscience_author">@dc.contributor.author@</span>
            @group.dc-contributor-author.end@
            </p>
            <span class="text-muted small mb-0">
                <span class="infoscience_journal_publisher"><i>@dc.publisher@</i></span>
                <span>. </span>
                <span class="infoscience_publication_date">@dc.date.issued@</span>
                <span>. </span>
                <span class="infoscience_doi">DOI : @dc.identifier.doi@</span>
            </span>
        </div>
        <div class="col-md-2 text-right mt-4 mt-md-0">
            <p class="infoscience_detailed_record_link">
                <a href="https://epfl-poc.4science.cloud/items/@virtual.id@" class="btn btn-secondary btn-sm" target="_blank">Detailed record</a>
            </p>
            <p class="text-muted small mb-0">
                <a class="text-muted" href="https://dx.doi.org/@dc.identifier.doi@" target="_blank">View at publisher</a>
            </p>
        </div>
    </div>
</div>