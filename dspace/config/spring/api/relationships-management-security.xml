<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"

       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
           http://www.springframework.org/schema/util
           http://www.springframework.org/schema/util/spring-util-3.0.xsd">

    <util:map id="relationshipsManagementAccessPolicies">
        <entry key="orgunit" value-ref="orgunitEditorsAccessModeList"/>
        <entry key="virtualcollection" value-ref="virtualCollectionCuratorsAccessModeList"/>
    </util:map>

    <util:list id="orgunitEditorsAccessModeList">
        <bean class="org.dspace.versioning.VersioningItemMode">
            <property name="securities">
                <list>
                    <value>CUSTOM</value>
                </list>
            </property>
            <property name="items" ref="orgunitEditor" />
        </bean>
    </util:list>

    <util:list id="orgunitEditor" value-type="java.lang.String">
        <value>epfl.orgUnit.editor</value>
        <value>crisou.director</value>
    </util:list>

    <util:list id="virtualCollectionCuratorsAccessModeList">
        <bean class="org.dspace.versioning.VersioningItemMode">
            <property name="securities">
                <list>
                    <value>CUSTOM</value>
                </list>
            </property>
            <property name="users" ref="virtualCollectionCurator" />
        </bean>
    </util:list>

    <util:list id="virtualCollectionCurator" value-type="java.lang.String">
        <value>epfl.virtualCollection.head</value>
        <value>epfl.virtualCollection.curator</value>
    </util:list>

</beans>
