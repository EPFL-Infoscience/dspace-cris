<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd" default-lazy-init="true">

    <bean name="org.dspace.storage.bitstore.BitstreamStorageService" class="org.dspace.storage.bitstore.BitstreamStorageServiceImpl">
        <!-- assetstore.index.primary will be 2 in test and 1 in prod -->
        <property name="incoming" value="${assetstore.index.primary}"/>
        <property name="stores">
            <map>
                <!-- Test environment will have read-only access to prod assetstore -->
                <entry key="0" value-ref="localStore"/>
                <entry key="1" value-ref="s3StorePROD"/>
                <entry key="2" value-ref="s3StoreTEST"/>
            </map>
        </property>
    </bean>

    <bean name="localStore" class="org.dspace.storage.bitstore.DSBitStoreService" scope="singleton">
        <property name="baseDir" value="${assetstore.dir}"/>
    </bean>

    <bean name="s3StoreTEST" class="org.dspace.storage.bitstore.S3BitStoreService" scope="singleton" lazy-init="true">
        <property name="enabled" value="${assetstore.s3.enabled_TEST}"/>
        <!-- AWS Security credentials, with policies for specified bucket -->
        <property name="awsAccessKey" value="${assetstore.s3.awsAccessKey_TEST}"/>
        <property name="awsSecretKey" value="${assetstore.s3.awsSecretKey_TEST}"/>
        <property name="awsSessionToken" value="${assetstore.s3.awsToken_TEST}"/>
        <property name="useRelativePath" value="${assetstore.s3.useRelativePath_TEST}"/>

        <!-- S3 bucket name to store assets in. example: longsight-dspace-auk -->
        <property name="bucketName" value="${assetstore.s3.bucketName_TEST}"/>

        <!-- AWS S3 Region to use: {us-east-1, us-west-1, eu-west-1, eu-central-1, ap-southeast-1, ... } -->
        <!-- Optional, sdk default is us-east-1 -->
        <property name="awsRegionName" value="${assetstore.s3.awsRegionName_TEST}"/>

        <!-- Subfolder to organize assets within the bucket, in case this bucket is shared  -->
        <!-- Optional, default is root level of bucket -->
        <property name="subfolder" value="${assetstore.s3.subfolder_TEST}"/>
    </bean>

    <bean name="s3StorePROD" class="org.dspace.storage.bitstore.S3BitStoreService" scope="singleton" lazy-init="true">
        <property name="enabled" value="${assetstore.s3.enabled_PROD}"/>
        <!-- AWS Security credentials, with policies for specified bucket -->
        <property name="awsAccessKey" value="${assetstore.s3.awsAccessKey_PROD}"/>
        <property name="awsSecretKey" value="${assetstore.s3.awsSecretKey_PROD}"/>
        <property name="awsSessionToken" value="${assetstore.s3.awsToken_PROD}"/>
        <property name="useRelativePath" value="${assetstore.s3.useRelativePath_PROD}"/>

        <!-- S3 bucket name to store assets in. example: longsight-dspace-auk -->
        <property name="bucketName" value="${assetstore.s3.bucketName_PROD}"/>

        <!-- AWS S3 Region to use: {us-east-1, us-west-1, eu-west-1, eu-central-1, ap-southeast-1, ... } -->
        <!-- Optional, sdk default is us-east-1 -->
        <property name="awsRegionName" value="${assetstore.s3.awsRegionName_PROD}"/>

        <!-- Subfolder to organize assets within the bucket, in case this bucket is shared  -->
        <!-- Optional, default is root level of bucket -->
        <property name="subfolder" value="${assetstore.s3.subfolder_PROD}"/>
        <property name="maxConnections" value="${assetstore.s3.maxConnections}"/>
        <property name="connectionTimeout" value="${assetstore.s3.connectionTimeout}"/>
        <property name="endpoint" value="${assetstore.s3.endpoint}"/>
    </bean>

    <!-- <bean name="localStore2 ... -->
    <!-- <bean name="s3Store2 ... -->
</beans>
