<?xml version="1.0" encoding="UTF-8" ?>
<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd"
    default-lazy-init="true"
>

  <bean
      name="org.dspace.storage.bitstore.BitstreamStorageService"
      class="org.dspace.storage.bitstore.BitstreamStorageServiceImpl"
  >
        <!-- assetstore.index.primary will be 2 in test and 1 in prod -->
        <property name="incoming" value="${assetstore.index.primary}"/>
        <property name="stores">
            <map>
                <!-- Test environment will have read-only access to prod assetstore -->
                <entry key="0" value-ref="localStore"/>
                <entry key="1" value-ref="s3StorePROD"/>
                <entry key="2" value-ref="s3StoreTEST"/>
            </map>
        </property>
    </bean>

    <bean name="localStore" class="org.dspace.storage.bitstore.DSBitStoreService">
        <property name="baseDir" value="${assetstore.dir}"/>
    </bean>

    <bean name="s3StoreTEST" class="org.dspace.storage.bitstore.S3BitStoreService" scope="singleton" lazy-init="true">
        <property name="enabled" value="${assetstore.s3.TEST.enabled}"/>
        <property name="useRelativePath" value="${assetstore.s3.TEST.useRelativePath}"/>

        <!-- S3 bucket name to store assets in. example: longsight-dspace-auk -->
        <property name="bucketName" value="${assetstore.s3.TEST.bucketName}"/>

        <!-- Subfolder to organize assets within the bucket, in case this bucket is shared  -->
        <!-- Optional, default is root level of bucket -->
        <property name="subfolder" value="${assetstore.s3.TEST.subfolder}"/>

        <!-- The algorithm the S3 client will use to create a checksum when doing putObject. -->
        <property name="s3ChecksumAlgorithm" value="${assetstore.s3.s3ChecksumAlgorithm}"/>

        <property name="builder" ref="testClientBuilder"/>
        <property name="presignedUrlStrategy" ref="presignedUrlTESTStrategy"/>
    </bean>

    <bean name="s3StorePROD" class="org.dspace.storage.bitstore.S3BitStoreService" scope="singleton" lazy-init="true">
      <property name="enabled" value="${assetstore.s3.PROD.enabled}"/>
      <property name="useRelativePath" value="${assetstore.s3.PROD.useRelativePath}"/>

      <!-- S3 bucket name to store assets in. example: longsight-dspace-auk -->
      <property name="bucketName" value="${assetstore.s3.PROD.bucketName}"/>

      <!-- Subfolder to organize assets within the bucket, in case this bucket is shared  -->
      <!-- Optional, default is root level of bucket -->
      <property name="subfolder" value="${assetstore.s3.PROD.subfolder}"/>

      <!-- The algorithm the S3 client will use to create a checksum when doing putObject. -->
      <property name="s3ChecksumAlgorithm" value="${assetstore.s3.s3ChecksumAlgorithm}"/>

      <property name="builder" ref="prodClientBuilder"/>
      <property name="presignedUrlStrategy" ref="presignedUrlPRODStrategy"/>
    </bean>

    <bean name="awsCredentialsFactory"
          class="org.dspace.storage.bitstore.factory.AWSFactory"/>

    <!-- Default client builder -->
    <bean name="defaultClientBuilder"
          factory-bean="awsCredentialsFactory"
          factory-method="clientBuilder"/>

    <!-- TEST client builder -->
    <bean name="testClientBuilder"
          factory-bean="awsCredentialsFactory"
          factory-method="clientBuilder">
      <constructor-arg name="storeSuffix" value="TEST"/>
    </bean>

    <!-- PROD client builder -->
    <bean name="prodClientBuilder"
          factory-bean="awsCredentialsFactory"
          factory-method="clientBuilder">
      <constructor-arg name="storeSuffix" value="PROD"/>
    </bean>

    <!-- Temp client builder -->
    <bean name="tempClientBuilder"
          factory-bean="awsCredentialsFactory"
          factory-method="clientBuilder">
        <constructor-arg name="storeSuffix" value="temp"/>
    </bean>

    <!-- Presigned URL strategy: uses CloudFront if distribution domain is configured, otherwise falls back to S3 -->

    <bean name="presignedUrlTESTStrategy" class="org.dspace.storage.bitstore.PresignedUrlStrategyFactoryBean">
          <property name="distributionDomain" value="${assetstore.s3.cloudfront.distribution.domain_TEST:}"/>
          <property name="keyPairId" value="${assetstore.s3.cloudfront.key.id:}"/>
          <property name="privateKeyPath" value="${assetstore.s3.cloudfront.private.key.path:}"/>
          <property name="s3ClientBuilder" ref="defaultClientBuilder"/>
      </bean>

    <bean name="presignedUrlPRODStrategy" class="org.dspace.storage.bitstore.PresignedUrlStrategyFactoryBean">
      <property name="distributionDomain" value="${assetstore.s3.cloudfront.distribution.domain_PROD:}"/>
      <property name="keyPairId" value="${assetstore.s3.cloudfront.key.id:}"/>
      <property name="privateKeyPath" value="${assetstore.s3.cloudfront.private.key.path:}"/>
      <property name="s3ClientBuilder" ref="defaultClientBuilder"/>
    </bean>



