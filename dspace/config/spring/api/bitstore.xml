<?xml version="1.0" encoding="UTF-8" ?>
<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd"
    default-lazy-init="true"
>

  <bean
      name="org.dspace.storage.bitstore.BitstreamStorageService"
      class="org.dspace.storage.bitstore.BitstreamStorageServiceImpl"
  >
        <!-- assetstore.index.primary will be 2 in test and 1 in prod -->
        <property name="incoming" value="${assetstore.index.primary}"/>
        <property name="stores">
            <map>
                <!-- Test environment will have read-only access to prod assetstore -->
                <entry key="0" value-ref="localStore"/>
                <entry key="1" value-ref="s3StorePROD"/>
                <entry key="2" value-ref="s3StoreTEST"/>
            </map>
        </property>
    </bean>

    <bean name="localStore" class="org.dspace.storage.bitstore.DSBitStoreService">
        <property name="baseDir" value="${assetstore.dir}"/>
    </bean>

    <bean name="s3StoreTEST" class="org.dspace.storage.bitstore.S3BitStoreService" scope="singleton" lazy-init="true">
        <property name="enabled" value="${assetstore.s3.enabled_TEST}"/>
        <!-- AWS Security credentials, with policies for specified bucket -->
        <property name="awsAccessKey" value="${assetstore.s3.awsAccessKey_TEST}"/>
        <property name="awsSecretKey" value="${assetstore.s3.awsSecretKey_TEST}"/>
        <property name="awsSessionToken" value="${assetstore.s3.awsToken_TEST}"/>
        <property name="useRelativePath" value="${assetstore.s3.useRelativePath_TEST}"/>

        <!-- S3 bucket name to store assets in. example: longsight-dspace-auk -->
        <property name="bucketName" value="${assetstore.s3.bucketName_TEST}"/>

        <!-- AWS S3 Region to use: {us-east-1, us-west-1, eu-west-1, eu-central-1, ap-southeast-1, ... } -->
        <!-- Optional, sdk default is us-east-1 -->
        <property name="awsRegionName" value="${assetstore.s3.awsRegionName_TEST}"/>

        <!-- Subfolder to organize assets within the bucket, in case this bucket is shared  -->
        <!-- Optional, default is root level of bucket -->
        <property name="subfolder" value="${assetstore.s3.subfolder}"/>

        <!-- The algorithm the S3 client will use to create a checksum when doing putObject. -->
        <property name="s3ChecksumAlgorithm" value="${assetstore.s3.s3ChecksumAlgorithm}"/>

        <property name="builder" ref="defaultClientBuilder"/>
        <property name="presignedUrlStrategy" ref="presignedUrlStrategy"/>
    </bean>

    <bean name="s3TempStore" class="org.dspace.storage.bitstore.S3BitStoreService" lazy-init="true" parent="s3Store">
        <property name="enabled" value="${assetstore.s3.temp.enabled}"/>
        <property name="bucketName" value="${assetstore.s3.temp.bucketName}"/>

        <!-- Subfolder to organize assets within the bucket, in case this bucket is shared  -->
        <!-- Optional, default is root level of bucket -->
        <property name="subfolder" value="${assetstore.s3.temp.subfolder}"/>
        <property name="builder" ref="tempClientBuilder"/>
    </bean>

    <bean name="awsCredentialsFactory"
          class="org.dspace.storage.bitstore.factory.AWSFactory"/>

    <!-- Default client builder -->
    <bean name="defaultClientBuilder"
          factory-bean="awsCredentialsFactory"
          factory-method="clientBuilder"/>

    <!-- Temp client builder -->
    <bean name="tempClientBuilder"
          factory-bean="awsCredentialsFactory"
          factory-method="clientBuilder">
        <constructor-arg name="storeSuffix" value="temp"/>
    </bean>

    <!-- Presigned URL strategy: uses CloudFront if distribution domain is configured, otherwise falls back to S3 -->
    <bean name="presignedUrlStrategy" class="org.dspace.storage.bitstore.PresignedUrlStrategyFactoryBean">
        <property name="distributionDomain" value="${assetstore.s3.cloudfront.distribution.domain:}"/>
        <property name="keyPairId" value="${assetstore.s3.cloudfront.key.id:}"/>
        <property name="privateKeyPath" value="${assetstore.s3.cloudfront.private.key.path:}"/>
        <property name="s3ClientBuilder" ref="defaultClientBuilder"/>
    </bean>

  <bean name="s3StorePROD" class="org.dspace.storage.bitstore.S3BitStoreService" scope="singleton" lazy-init="true">
    <property name="enabled" value="${assetstore.s3.enabled_PROD}"/>
    <!-- AWS Security credentials, with policies for specified bucket -->
    <property name="awsAccessKey" value="${assetstore.s3.awsAccessKey_PROD}"/>
    <property name="awsSecretKey" value="${assetstore.s3.awsSecretKey_PROD}"/>
    <property name="awsSessionToken" value="${assetstore.s3.awsToken_PROD}"/>
    <property name="useRelativePath" value="${assetstore.s3.useRelativePath_PROD}"/>

    <!-- S3 bucket name to store assets in. example: longsight-dspace-auk -->
    <property name="bucketName" value="${assetstore.s3.bucketName_PROD}"/>

    <!-- AWS S3 Region to use: {us-east-1, us-west-1, eu-west-1, eu-central-1, ap-southeast-1, ... } -->
    <!-- Optional, sdk default is us-east-1 -->
    <property name="awsRegionName" value="${assetstore.s3.awsRegionName_PROD}"/>

    <!-- Subfolder to organize assets within the bucket, in case this bucket is shared  -->
    <!-- Optional, default is root level of bucket -->
    <property name="subfolder" value="${assetstore.s3.subfolder_PROD}"/>
    <property name="maxConnections" value="${assetstore.s3.maxConnections}"/>
    <property name="connectionTimeout" value="${assetstore.s3.connectionTimeout}"/>

    <!-- The target throughput for transfer requests in Gbps. Higher value means more connections will be established with S3.  -->
    <property name="targetThroughputGbps" value="${assetstore.s3.targetThroughputGbps}"/>

    <!-- Sets the minimum part size for transfer parts. Decreasing the minimum part size causes multipart transfer
         to be split into a larger number of smaller parts.
    -->
    <property name="minPartSizeBytes" value="${assetstore.s3.minPartSizeBytes}"/>

    <!-- Specifies the maximum number of S3 connections that should be established during a transfer.
         If not provided, it will be based on targetThroughputGbps
    -->
    <property name="maxConcurrency" value="${assetstore.s3.maxConcurrency}"/>

    <!-- The algorithm the S3 client will use to create a checksum when doing putObject. -->
    <property name="s3ChecksumAlgorithm" value="${assetstore.s3.s3ChecksumAlgorithm}"/>
  </bean>

    <bean name="awsCredentialsFactory"
          class="org.dspace.storage.bitstore.factory.AWSFactory"/>

    <!-- Default client builder -->
    <bean name="defaultClientBuilder"
          factory-bean="awsCredentialsFactory"
