<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"

       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
           http://www.springframework.org/schema/util
           http://www.springframework.org/schema/util/spring-util-3.0.xsd">

    <util:list id="viewUsageStatisticsAccessModesList">
        <bean class="org.dspace.versioning.VersioningItemMode">
            <property name="securities">
                <list>
                    <value>ALL</value>
                </list>
            </property>
            <property name="additionalFilter" ref="loggedInFilter" />
        </bean>
    </util:list>
    <bean name="loggedInFilter" class="org.dspace.content.security.LoggedInFilter"/>
    <bean id="org.dspace.versioning.service.ViewStatisticsService"
          class="org.dspace.versioning.ViewStatisticsServiceImpl"/>
</beans>
