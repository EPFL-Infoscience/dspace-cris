<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

	<bean id="uploadConfigurationDefault" class="org.dspace.submit.model.UploadConfiguration">
		<property name="name" value="upload"/>
		<property name="metadata" value="bitstream-metadata" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
                <!-- <ref bean="networkAdministration"/> -->
            </list>
        </property>
    </bean>

    <bean id="openAccess" class="org.dspace.submit.model.AccessConditionOption">
        <property name="groupName" value="Anonymous"/>
        <property name="name" value="openaccess"/>
        <property name="hasStartDate" value="false"/>
        <property name="hasEndDate" value="false"/>
    </bean>
    <bean id="lease" class="org.dspace.submit.model.AccessConditionOption">
        <property name="groupName" value="Anonymous"/>
        <property name="name" value="lease"/>
        <property name="hasStartDate" value="false"/>
        <property name="hasEndDate" value="true"/>
        <property name="endDateLimit" value="+6MONTHS"/>
    </bean>
    <bean id="embargoed" class="org.dspace.submit.model.AccessConditionOption">
        <property name="groupName" value="Anonymous"/>
        <property name="name" value="embargo"/>
        <property name="hasStartDate" value="true"/>
        <property name="startDateLimit" value="+36MONTHS"/>
        <property name="hasEndDate" value="false"/>
    </bean>
    <bean id="reserved" class="org.dspace.submit.model.AccessConditionOption">
        <property name="groupName" value="ReservedAccess"/>
        <property name="name" value="reserved"/>
        <property name="hasStartDate" value="false"/>
        <property name="hasEndDate" value="false"/>
    </bean>
<!--     <bean id="networkAdministration" class="org.dspace.submit.model.AccessConditionOption">
    	<property name="groupName" value="INSTITUTIONAL_NETWORK"/>
        <property name="name" value="networkAdministration"/>
        <property name="hasStartDate" value="false"/>
        <property name="hasEndDate" value="false"/>
    </bean> -->

    <bean id="uploadConfigurationService" class="org.dspace.submit.model.UploadConfigurationService">
        <property name="map">
            <map>
                <entry key="upload" value-ref="uploadConfigurationDefault" />
                <entry key="upload-publication" value-ref="uploadConfigurationPublication" />
                <entry key="upload-product" value-ref="uploadConfigurationProduct" />
                <entry key="upload-patent" value-ref="uploadConfigurationPatent" />
                <entry key="upload-event" value-ref="uploadConfigurationEvent" />
                <entry key="upload-person" value-ref="uploadConfigurationPerson" />
                <entry key="upload-orgunit" value-ref="uploadConfigurationOrgUnit" />
                <entry key="upload-journal" value-ref="uploadConfigurationJournal" />
                <entry key="upload-project" value-ref="uploadConfigurationProject" />
                <entry key="upload-funding" value-ref="uploadConfigurationFunding" />
                <entry key="upload-content" value-ref="uploadConfigurationContent" />
                <entry key="upload-equipment" value-ref="uploadConfigurationEquipment" />
            </map>
        </property>
    </bean>

    <bean id="accessConditionConfigurationService" class="org.dspace.submit.model.AccessConditionConfigurationService" />

    <bean id="accessConditionConfigurationDefault" class="org.dspace.submit.model.AccessConditionConfiguration">
        <!-- This name must match the id of the step as defined in the item-submission.xml -->
        <property name="name" value="itemAccessConditions" />
        <property name="canChangeDiscoverable" value="false" />
        <property name="singleAccessCondition" value="true" />
        <property name="onlyForOriginalBundle" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="restricted" class="org.dspace.submit.model.AccessConditionOption">
        <property name="groupName" value="LoggedIn"/>
        <property name="name" value="restricted"/>
        <property name="hasStartDate" value="false"/>
        <property name="hasEndDate" value="false"/>
    </bean>

    <bean id="uploadConfigurationPublication" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-publication" />
        <property name="metadata" value="bitstream-metadata-publication" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="uploadConfigurationProduct" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-product" />
        <property name="metadata" value="bitstream-metadata-product" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="uploadConfigurationPatent" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-patent" />
        <property name="metadata" value="bitstream-metadata-patent" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="uploadConfigurationEvent" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-event" />
        <property name="metadata" value="bitstream-metadata-event" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="uploadConfigurationPerson" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-person" />
        <property name="metadata" value="bitstream-metadata-person" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="uploadConfigurationOrgUnit" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-orgunit" />
        <property name="metadata" value="bitstream-metadata-orgunit" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="uploadConfigurationJournal" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-journal" />
        <property name="metadata" value="bitstream-metadata-journal" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>


    <bean id="uploadConfigurationProject" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-project" />
        <property name="metadata" value="bitstream-metadata-project" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>


    <bean id="uploadConfigurationFunding" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-funding" />
        <property name="metadata" value="bitstream-metadata-funding" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="uploadConfigurationContent" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-publication" />
        <property name="metadata" value="bitstream-metadata-content" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="uploadConfigurationEquipment" class="org.dspace.submit.model.UploadConfiguration">
        <property name="name" value="upload-equipment" />
        <property name="metadata" value="bitstream-metadata-content" />
        <property name="singleAccessCondition" value="true" />
        <property name="options">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
    </bean>

    <bean id="defaultBulkAccessConditionConfiguration"
          class="org.dspace.app.bulkaccesscontrol.model.BulkAccessConditionConfiguration">
        <property name="name" value="default"/>
        <property name="itemAccessConditionOptions">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed" />
                <ref bean="restricted"/>
            </list>
        </property>
        <property name="bitstreamAccessConditionOptions">
            <list>
                <ref bean="openAccess"/>
                <ref bean="embargoed"/>
                <ref bean="restricted" />
            </list>
        </property>
    </bean>

    <bean id="bulkAccessConditionConfigurationService"
          class="org.dspace.app.bulkaccesscontrol.service.BulkAccessConditionConfigurationService">
        <property name="bulkAccessConditionConfigurations">
            <list>
                <ref bean="defaultBulkAccessConditionConfiguration"/>
            </list>
        </property>
    </bean>

</beans>
